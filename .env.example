# =============================================================================
# Telegram Aircraft Alert Bot - Environment Configuration
# =============================================================================
# Copy to .env for a VM deployment. Never commit the populated .env file.

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Leave blank for long polling. Set a public HTTPS base URL to use webhooks.
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=aircraft_bot

# --- Aircraft Data Providers ---
ADSB_LOL_BASE_URL=https://api.adsb.lol/v2
ADSB_FI_BASE_URL=https://opendata.adsb.fi/api/v2
AIRPLANES_LIVE_BASE_URL=https://api.airplanes.live/v2
ADSB_ONE_BASE_URL=https://api.adsb.one/v2
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# Preferred hosted format. Keep this in your cloud secret/environment manager.
# Example: [{"clientId":"id1","clientSecret":"secret1"}]
OPENSKY_CREDENTIALS_JSON=

# Optional local fallback directory. JSON files in this directory are ignored by git.
API_KEYS_DIR=api

# --- AI Providers (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_SECONDARY=gemini-3.1-flash-lite

# Optional fallback provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Monitoring Settings ---
POLL_INTERVAL_SECONDS=5
DEFAULT_RADIUS_KM=15.0
COOLDOWN_MINUTES=30

# --- Per-User Silent Learning ---
LEARNING_PLANE_THRESHOLD=100
RELEARN_PLANE_COUNT=25

# --- Admin & Dashboard ---
ADMIN_TELEGRAM_ID=
# Strongly recommended when exposing the web service publicly.
ADMIN_PASSWORD=

# --- Server / Network ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
