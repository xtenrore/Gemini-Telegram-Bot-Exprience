# =============================================================================
# Aircraft Alert Slack Bot - Environment Configuration
# =============================================================================
# Copy to .env for local use. Never commit populated secret values.

# --- Slack (required) ---
# Bot OAuth token from your Slack app (starts with xoxb-)
SLACK_BOT_TOKEN=
# App-level token with connections:write for Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=
# Optional channel for shared aircraft/admin alerts.
SLACK_ALERT_CHANNEL_ID=
# Optional Slack user ID for admin DM fallback.
ADMIN_SLACK_USER_ID=

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=aircraft_bot

# --- Aircraft Data Providers ---
ADSB_LOL_BASE_URL=https://api.adsb.lol/v2
ADSB_FI_BASE_URL=https://opendata.adsb.fi/api/v2
AIRPLANES_LIVE_BASE_URL=https://api.airplanes.live/v2
ADSB_ONE_BASE_URL=https://api.adsb.one/v2
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_CREDENTIALS_JSON=
API_KEYS_DIR=api

# --- AI Providers ---
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_SECONDARY=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Monitoring ---
POLL_INTERVAL_SECONDS=5
DEFAULT_RADIUS_KM=15.0
COOLDOWN_MINUTES=30
LEARNING_PLANE_THRESHOLD=100
RELEARN_PLANE_COUNT=25

# --- Admin dashboard ---
ADMIN_PASSWORD=

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
