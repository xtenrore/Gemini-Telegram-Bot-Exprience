# =============================================================================
# Telegram Aircraft Alert Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Webhook Configuration (Optional):
# - Leave WEBHOOK_URL empty to run in Long Polling mode (no public domain or open ports needed!)
# - Or set to your public domain (e.g. https://alerts.yourdomain.com) to use Webhooks
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- MongoDB ---
# If running MongoDB locally on the VM (installed by setup.sh):
MONGO_URI=mongodb://localhost:27017
# Or for MongoDB Atlas: mongodb+srv://username:password@cluster0.mongodb.net/
DATABASE_NAME=aircraft_bot

# --- Aircraft Data Providers (High-Speed ADS-B Feeds) ---
ADSB_LOL_BASE_URL=https://api.adsb.lol/v2
ADSB_FI_BASE_URL=https://opendata.adsb.fi/api/v2
AIRPLANES_LIVE_BASE_URL=https://api.airplanes.live/v2
ADSB_ONE_BASE_URL=https://api.adsb.one/v2
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token

# Directory containing OpenSky API key JSON files (OAuth2 format)
API_KEYS_DIR=api

# --- AI Providers (Free Tiers - Optional for conflict resolution & feedback) ---
# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-2.0-flash-lite

# Groq API Key (Groq Console — 30 RPM unlimited daily)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Monitoring Settings ---
# Polling interval in seconds (default 5s for fast trajectory tracking)
POLL_INTERVAL_SECONDS=5

# Default monitoring radius in kilometers
DEFAULT_RADIUS_KM=15.0

# Notification cooldown in minutes (same aircraft won't re-notify within this window)
COOLDOWN_MINUTES=30

# --- Per-User Silent Learning ---
# Number of unique aircraft to observe per user/region before selecting optimal providers
LEARNING_PLANE_THRESHOLD=100
RELEARN_PLANE_COUNT=25

# --- Admin & Dashboard ---
# Your Telegram user ID for admin alerts (optional)
ADMIN_TELEGRAM_ID=

# Optional password for the web admin panel (/admin)
ADMIN_PASSWORD=

# --- Server / Network ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
